<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialogRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="28dp"
    app:cardElevation="16dp"
    app:cardBackgroundColor="@color/background"
    android:animateLayoutChanges="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="32dp"
            android:paddingBottom="20dp"
            android:paddingHorizontal="24dp">

            <FrameLayout
                android:id="@+id/iconContainer"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/ic_extension_bg"
                android:elevation="4dp">
                <TextView android:id="@+id/extensionIcon"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:text="🧩" android:textSize="32sp" />
            </FrameLayout>

            <TextView android:id="@+id/dialogTitle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="Install Extension"
                android:textSize="22sp" android:textStyle="bold"
                android:textColor="@color/on_background" android:letterSpacing="0.02" />

            <TextView android:id="@+id/extensionUrl"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="addons.mozilla.org"
                android:textSize="13sp" android:textColor="@color/on_surface_variant"
                android:maxLines="1" android:ellipsize="middle" />
        </LinearLayout>

        <!-- Divider -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/on_surface_variant" android:alpha="0.12" />

        <!-- Permissions Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingHorizontal="24dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Permissions Required"
                    android:textSize="15sp" android:textStyle="bold"
                    android:textColor="@color/on_background" />
                <TextView android:id="@+id/permissionCount"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0 items" android:textSize="12sp"
                    android:textColor="@color/on_surface_variant"
                    android:background="@drawable/badge_background"
                    android:paddingHorizontal="10dp" android:paddingVertical="2dp" />
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="This extension needs access to:"
                android:textSize="12sp" android:textColor="@color/on_surface_variant" />

            <LinearLayout android:id="@+id/permissionsContainer"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="12dp"
                android:divider="@android:drawable/divider_horizontal_bright"
                android:showDividers="middle" />
        </LinearLayout>

        <!-- Divider -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/on_surface_variant" android:alpha="0.12" />

        <!-- Private Browsing Toggle -->
        <LinearLayout android:id="@+id/privateBrowsingSection"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingVertical="14dp" android:paddingHorizontal="24dp"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Allow in Private Browsing" android:textSize="14sp"
                    android:textStyle="bold" android:textColor="@color/on_background" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Extension works in private tabs too" android:textSize="12sp"
                    android:textColor="@color/on_surface_variant" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat android:id="@+id/checkPrivateBrowsing"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:thumbTint="?attr/colorPrimary"
                android:trackTint="?attr/colorPrimary" />
        </LinearLayout>

        <!-- Divider -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/on_surface_variant" android:alpha="0.12" />

        <!-- Action Buttons -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="end"
            android:paddingTop="14dp" android:paddingBottom="24dp"
            android:paddingStart="16dp" android:paddingEnd="20dp">

            <com.google.android.material.button.MaterialButton android:id="@+id/btnCancel"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content" android:layout_height="48dp"
                android:text="Cancel" android:textSize="14sp"
                app:cornerRadius="24dp" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btnAdd"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content" android:layout_height="48dp"
                android:layout_marginStart="12dp" android:text="Add Extension"
                android:textSize="14sp" android:textStyle="bold"
                app:cornerRadius="24dp"
                app:icon="@android:drawable/ic_input_add"
                app:iconGravity="textStart" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
