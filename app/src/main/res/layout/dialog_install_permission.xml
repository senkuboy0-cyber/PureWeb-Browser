<?xml version="1.0" encoding="utf-8"?>
<!--
    PureWeb Browser - Extension Install Permission Dialog
    Material 3 Design with Smooth Animations
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialogRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="28dp"
    app:cardElevation="16dp"
    app:cardBackgroundColor="?android:colorBackground"
    android:animateLayoutChanges="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 🔷 Header Section with Gradient-style Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="32dp"
            android:paddingBottom="20dp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp">

            <!-- Extension Icon Circle -->
            <FrameLayout
                android:id="@+id/iconContainer"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/ic_extension_bg"
                android:elevation="4dp"
                android:translationZ="4dp">

                <TextView
                    android:id="@+id/extensionIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🧩"
                    android:textSize="32sp" />

            </FrameLayout>

            <!-- Extension Name -->
            <TextView
                android:id="@+id/dialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Install Extension"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="?android:textColorPrimary"
                android:letterSpacing="0.02" />

            <!-- Extension Source URL -->
            <TextView
                android:id="@+id/extensionUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="addons.mozilla.org"
                android:textSize="13sp"
                android:textColor="?android:textColorSecondary"
                android:maxLines="1"
                android:ellipsize="middle" />

        </LinearLayout>

        <!-- 🔸 Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:textColorSecondary"
            android:alpha="0.12" />

        <!-- 📋 Permissions Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Permissions Required"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?android:textColorPrimary" />

                <TextView
                    android:id="@+id/permissionCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 items"
                    android:textSize="12sp"
                    android:textColor="?android:textColorSecondary"
                    android:background="@drawable/badge_background"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="2dp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="This extension needs access to:"
                android:textSize="12sp"
                android:textColor="?android:textColorSecondary" />

            <!-- Permission Items Container (added programmatically) -->
            <LinearLayout
                android:id="@+id/permissionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:divider="@android:drawable/divider_horizontal_bright"
                android:showDividers="middle" />

        </LinearLayout>

        <!-- 🔸 Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="?android:textColorSecondary"
            android:alpha="0.12" />

        <!-- 🔒 Private Browsing Toggle -->
        <LinearLayout
            android:id="@+id/privateBrowsingSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?selectableItemBackground">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Allow in Private Browsing"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?android:textColorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Extension works in private tabs too"
                    android:textSize="12sp"
                    android:textColor="?android:textColorSecondary" />

            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/checkPrivateBrowsing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="?attr/colorPrimary"
                android:trackTint="?attr/colorPrimary"
                android:trackTintMode="src_atop"
                android:alpha="0.6" />

        </LinearLayout>

        <!-- 🔸 Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:textColorSecondary"
            android:alpha="0.12" />

        <!-- 🎯 Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:paddingTop="14dp"
            android:paddingBottom="24dp"
            android:paddingLeft="16dp"
            android:paddingRight="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Cancel"
                android:textSize="14sp"
                app:cornerRadius="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdd"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:text="Add Extension"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="24dp"
                app:icon="@android:drawable/ic_input_add"
                app:iconGravity="textStart" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
