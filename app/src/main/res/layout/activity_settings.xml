<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#131315">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Search Engine"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#00E5FF"/>

    <RadioGroup
        android:id="@+id/radioGroupEngine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp">

        <RadioButton
            android:theme="@style/RadioButtonStyle"
            android:id="@+id/radioGoogle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Google"
            android:textSize="16sp"/>

        <RadioButton
            android:theme="@style/RadioButtonStyle"
            android:id="@+id/radioDuckDuckGo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DuckDuckGo (Privacy)"
            android:textSize="16sp"
            android:checked="true"/>

        <RadioButton
            android:theme="@style/RadioButtonStyle"
            android:id="@+id/radioBing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bing"
            android:textSize="16sp"/>
            
    </RadioGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#353437"
        android:layout_marginVertical="20dp"/>

    <!-- Extension Store Button -->
    <Button
        android:id="@+id/btnOpenExtensions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Extension Store"
        android:backgroundTint="#00E5FF"
        android:textAllCaps="false"/>

    <!-- uBlock Origin Install Button -->
    <Button
        android:id="@+id/btnInstallAdBlocker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Install uBlock Origin"
        android:backgroundTint="#00E5FF"
        android:textAllCaps="false"/>

    <!-- Custom Extension Button -->
    <Button
        android:id="@+id/btnCustomExtension"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Developer: Install Custom Extension"
        android:backgroundTint="#00E5FF"
        android:textAllCaps="false"/>

    <!-- Clear Cache Button -->
    <Button
        android:id="@+id/btnClearCache"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Clear Browsing Data"
        android:backgroundTint="#ffb4ab"/>

</LinearLayout>