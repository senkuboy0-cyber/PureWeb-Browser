<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Search Engine"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#000000"/>

    <RadioGroup
        android:id="@+id/radioGroupEngine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp">

        <RadioButton
            android:id="@+id/radioGoogle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Google"
            android:textSize="16sp"/>

        <RadioButton
            android:id="@+id/radioDuckDuckGo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DuckDuckGo (Privacy)"
            android:textSize="16sp"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/radioBing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bing"
            android:textSize="16sp"/>
            
    </RadioGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginVertical="20dp"/>

    <!-- Open Extension Store Button -->
    <Button
        android:id="@+id/btnOpenExtensions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open Extension Store"
        android:backgroundTint="#2196F3"
        android:textAllCaps="false"/>

    <!-- uBlock Origin Install Button -->
    <Button
        android:id="@+id/btnInstallAdBlocker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Install uBlock Origin"
        android:backgroundTint="#4CAF50"
        android:textAllCaps="false"/>

    <!-- কাস্টম এক্সটেনশন বাটন -->
    <Button
        android:id="@+id/btnCustomExtension"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Developer: Install Custom Extension"
        android:backgroundTint="#9C27B0"
        android:textAllCaps="false"/>

    <Button
        android:id="@+id/btnClearCache"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Clear Browsing Data"
        android:backgroundTint="#F44336"/>

</LinearLayout>